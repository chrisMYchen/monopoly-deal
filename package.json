{
  "name": "monopoly-deal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --port 8787",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "server:dev": "bun worker/src/dev-server.ts",
    "server:dev:inject": "DEV_INJECT=1 bun worker/src/dev-server.ts",
    "test:e2e": "bun worker/test/scenarios.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@phosphor-icons/react": "^2.1.7",
    "canvas-confetti": "^1.9.4",
    "immer": "^10.1.1",
    "motion": "^11.18.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "wrangler": "^4"
  }
}
