# Optional. Defaults documented inline.

# Static export uses this to point the client at the deployed worker.
# Local dev infers ws://localhost:8787 if unset.
# NEXT_PUBLIC_WORKER_ORIGIN=https://realty-royale-worker.your-subdomain.workers.dev

# Bun dev-server port (worker/src/dev-server.ts). Default: 8787.
# PORT=8787

# Enables /dev/state/<code> inspect+inject endpoints in the bun dev-server.
# Required by `bun run test:e2e`. Off in production CF Worker by definition.
# DEV_INJECT=1

# Where the headless sim and check:up look for things. Defaults shown.
# APP=http://localhost:3000
# WORKER=http://localhost:8787

# No Cloudflare credentials live here — wrangler deploys are CI-only and
# read CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID from GH Actions secrets.
